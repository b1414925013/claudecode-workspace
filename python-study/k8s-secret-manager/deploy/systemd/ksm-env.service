[Unit]
Description=KSM Environment Service
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=ksm
WorkingDirectory=/opt/k8s-secret-manager
EnvironmentFile=/opt/k8s-secret-manager/.env
ExecStart=/opt/k8s-secret-manager/.venv/bin/uv run --package ksm-env uvicorn ksm_env.main:app --host 0.0.0.0 --port 8002
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
