[Unit]
Description=KSM API Gateway
After=network.target mysql.service auth-service.service env-service.service secret-service.service toolbox-service.service
Wants=mysql.service

[Service]
Type=simple
User=ksm
WorkingDirectory=/opt/k8s-secret-manager
EnvironmentFile=/opt/k8s-secret-manager/.env
ExecStart=/opt/k8s-secret-manager/.venv/bin/uv run --package ksm-gateway uvicorn ksm_gateway.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
